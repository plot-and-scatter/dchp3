{
  "exclude": [
    "../node_modules/@types/jest",
    "../node_modules/@testing-library/jest-dom"
  ],
  "include": [
    "e2e/**/*",
    "support/**/*",
    "../node_modules/cypress",
    "../node_modules/@testing-library/cypress"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "types": ["node", "cypress", "@testing-library/cypress"],
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "target": "es2019",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // TypeScript 5 resolves the "types" entries above only from typeRoots, and
    // cypress / @testing-library/cypress ship their own types rather than
    // living under @types — so node_modules itself has to be a root too.
    "typeRoots": ["../types", "../node_modules/@types", "../node_modules"],

    "paths": {
      "~/*": ["../app/*"]
    }
  }
}
