{
  "name": "dchp2-design-1e95",
  "private": true,
  "sideEffects": [
    "cypress/support/*.ts"
  ],
  "scripts": {
    "build": "run-s build:*",
    "build:css": "npm run generate:css -- --minify",
    "dev": "run-p dev:*",
    "dev:css": "npm run generate:css -- --watch",
    "format": "prettier --write .",
    "generate:css": "tailwindcss -o ./app/styles/tailwind.css",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "start": "react-router-serve ./build/server/index.js",
    "start-shell": "/usr/local/bin/dotenv -e .env.production react-router-serve ./build/server/index.js",
    "start:mocks": "binode --require ./mocks -- @react-router/serve:react-router-serve ./build/server/index.js",
    "test": "vitest",
    "test:e2e:dev": "start-server-and-test dev http://localhost:3000 \"npx cypress open\"",
    "pretest:e2e:run": "npm run build",
    "test:e2e:run": "cross-env PORT=8811 start-server-and-test start:mocks http://localhost:8811 \"npx cypress run\"",
    "typecheck": "tsc -b && tsc -b cypress",
    "validate": "run-p \"test -- --run\" lint typecheck test:e2e:run",
    "build:react-router": "react-router build",
    "dev:react-router": "cross-env NODE_ENV=development binode --require ./mocks -- @react-router/dev:react-router dev"
  },
  "prettier": {
    "semi": false
  },
  "eslintIgnore": [
    "/node_modules",
    "/build",
    "/.react-router"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/lib-storage": "^3.1117.0",
    "@conform-to/react": "^1.21.1",
    "@conform-to/zod": "^1.21.1",
    "@headlessui/react": "^1.7.5",
    "@popperjs/core": "^2.11.6",
    "@prisma/client": "^5.13.0",
    "@react-router/node": "^7.18.2",
    "@react-router/serve": "^7.18.2",
    "@remix-run/server-runtime": "^2.17.5",
    "@types/react-highlight-words": "^0.16.4",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.0.0",
    "crypto-js": "^4.2.0",
    "isbot": "^3.5.0",
    "isomorphic-dompurify": "^3.23.0",
    "minimatch": "^7.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-highlight-words": "^0.20.0",
    "react-popper": "^2.3.0",
    "react-router": "^7.18.2",
    "remix-auth": "^3.4.0",
    "remix-auth-auth0": "^1.7.0",
    "smartquotes": "^2.3.2",
    "tiny-invariant": "^1.2.0",
    "use-debounce": "^9.0.4",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^7.4.0",
    "@react-router/dev": "^7.18.2",
    "@react-router/remix-routes-option-adapter": "^7.18.2",
    "@remix-run/eslint-config": "^2.17.5",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/dom": "^8.17.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/bcryptjs": "^2.4.2",
    "@types/crypto-js": "^4.2.2",
    "@types/eslint": "^8.4.5",
    "@types/node": "^22.20.1",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.8",
    "binode": "^1.0.5",
    "cookie": "^0.5.0",
    "cross-env": "^7.0.3",
    "cypress": "^15.21.1",
    "eslint": "^8.22.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-cypress": "^2.15.2",
    "happy-dom": "^20.11.6",
    "msw": "^2.15.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.16",
    "prettier": "2.7.1",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "prisma": "^5.13.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^3.1.8",
    "ts-node": "^10.9.1",
    "ts-to-zod": "^3.1.3",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "ts-node --require tsconfig-paths/register prisma/seed.ts"
  }
}
