DATABASE_URL="file:./data.db?connection_limit=1"
SESSION_SECRET="super-duper-s3cret"

# The Auth0 Machine-to-Machine application used by app/services/auth/management.server.ts.
# This is a DIFFERENT Auth0 application from AUTH0_CLIENT_ID/AUTH0_CLIENT_SECRET,
# which belong to the login flow and cannot call the Management API. The M2M
# application must be authorized for the https://<AUTH0_DOMAIN>/api/v2/ audience
# with the scopes read:users, create:users, update:users, read:roles,
# create:role_members and delete:role_members.
AUTH0_MGMT_CLIENT_ID=""
AUTH0_MGMT_CLIENT_SECRET=""
