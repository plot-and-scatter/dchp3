# Every variable the application reads. Copy to .env and fill in.
#
# The values here are placeholders, not secrets. Real ones live in .env
# locally and in .env.production on the server, neither of which is committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DATABASE_URL="mysql://user:password@localhost:3306/dchp3"

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# Signs the session cookie. Changing it signs everyone out.
COOKIE_SECRET=""

SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Auth0
#
# TWO Auth0 applications, and they are not interchangeable. Getting this wrong
# is the most likely mistake in this section, so it is stated twice.
# ---------------------------------------------------------------------------

# Shared by both. No protocol: "example.us.auth0.com", not a URL.
AUTH0_DOMAIN=""

# APPLICATION ONE: the login flow. A Regular Web Application, doing the OIDC
# exchange in app/services/auth/auth.server.ts. Its Allowed Callback URLs must
# include <SITE_URL>/auth/auth0/callback.
#
# These credentials CANNOT call the Management API. Do not put them below.
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""

# APPLICATION TWO: user management. A Machine-to-Machine application, used by
# app/services/auth/management.server.ts to read and change users from
# /admin/users. Authorize it for the https://<AUTH0_DOMAIN>/api/v2/ audience
# with these seven scopes and no others:
#
#   read:users             the user list
#   read:roles             role names and ids, which differ per tenant
#   create:users           adding someone
#   update:users           changing a name, blocking, unblocking
#   create:role_members    giving someone a role
#   delete:role_members    taking one away; a role change is remove then add
#   create:user_tickets    the one-time link for setting a password
#
# delete:users is deliberately absent. Nothing in this application deletes a
# user, and a name is attached to entries and citations that should keep it.
#
# Without these, the site starts and runs normally; only /admin/users fails,
# and only when somebody opens it. See docs/auth/user-management.md.
AUTH0_MGMT_CLIENT_ID=""
AUTH0_MGMT_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# Used to build the Auth0 callback URL, so it must match the address the site
# is actually served from. Whether it starts with https also decides whether
# the session cookie is marked Secure.
SITE_URL="http://localhost:3000"

# Set to "staging" on staging. Shows a banner; nothing else depends on it.
DEPLOYMENT_ENV=""

# ---------------------------------------------------------------------------
# Entry images
# ---------------------------------------------------------------------------

IMAGE_BUCKET_S3_API=""
IMAGE_BUCKET_PREFIX=""
IMAGE_BUCKET_ACCESS_KEY_ID=""
IMAGE_BUCKET_SECRET_ACCESS_KEY=""
